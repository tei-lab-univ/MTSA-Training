//******************************************************************************
//*  Sample-1.lts (for MTSA)
//*  Create Date      : 2024/12/3
//*  Creator Name     : 
//*  MTSA run command : [java -jar -Xmx8G mtsa.jar] メモリサイズに応じて8Gは要変更
//*****************************************************************************/


//*****************************************************************************
// Environment
//*****************************************************************************

/* set variable */
const N = 2 //Nomber of Drone
const S = 3 //Max Height

range DroneID = 1..N
set   Drones = {drone[DroneID]}

const MaxX = 2 //ドローンは前後の数字の行先にしか移動できない（最小2）
const MaxY = 2 //ドローンは前後の数字の行先にしか移動できない（最小2）
const MaxH = S //ドローンは前後の数字の高さにしか移動できない

range X = 1..MaxX
range Y = 1..MaxY
range H = 1..MaxH
set Direction = {n,s,e,w}

/* set Actions (事象の集合) */
set ControllerbleActions = {[Drones].battery['safe], [Drones].takeoff, [Drones].land, [Drones].up, [Drones].down, [Drones].move[Direction]}


/* Drone モデル */

//電池残量管理
BATTERY = SAFE,
SAFE = (battery['low] -> LOW),//低電池状態
LOW  = (battery['safe] -> SAFE).//安全状態

//移動管理(こいつを高度flyだけと移動moveだけ分割したい)
MOVE = (takeoff -> arrive[1][1][1] -> ACTION[1][1][1]),//飛び立つ→最初の位置は1,1,1→actionに入る
ACTION[x:X][y:Y][h:H] = (when(x > 1)    move['w] -> arrive[x-1][y][h] -> ACTION[x-1][y][h]
				        |when(x < MaxX) move['e] -> arrive[x+1][y][h] -> ACTION[x+1][y][h]
				        |when(y > 1)    move['s] -> arrive[x][y-1][h] -> ACTION[x][y-1][h]
				        |when(y < MaxY) move['n] -> arrive[x][y+1][h] -> ACTION[x][y+1][h]
						|when(h > 1)    down     -> arrive[x][y][h-1] -> ACTION[x][y][h-1]
						|when(h < MaxH) up       -> arrive[x][y][h+1] -> ACTION[x][y][h+1]
                        |when(h == 1)   land -> MOVE).

|| DroneEnvironment = ([Drones]:BATTERY || [Drones]:MOVE).


//             N
//   ┏━━━┳━━━┳━━━┳━━━┳━━━┓
//   ┃   ┃   ┃   ┃   ┃   ┃
//   ┣━━━╋━━━╋━━━╋━━━╋━━━┫
//   ┃   ┃   ┃   ┃   ┃   ┃
//   ┣━━━╋━━━╋━━━╋━━━╋━━━┫
// W ┃   ┃   ┃   ┃   ┃   ┃ E
//   ┣━━━╋━━━╋━━━╋━━━╋━━━┫
//   ┃   ┃   ┃   ┃   ┃   ┃
//   ┣━━━╋━━━╋━━━╋━━━╋━━━┫
//   ┃ * ┃   ┃   ┃   ┃   ┃
//   ┗━━━┻━━━┻━━━┻━━━┻━━━┛
//             S
// x座標は横マス（一番左が1，一番右がMaxX）
// y座標は縦マス（一番下が1，一番上がMaxY）
// * = 初期座標（1,1）

//*****************************************************************************
// Requirement
//*****************************************************************************

const  LIMIT_X = 2
const  LIMIT_Y = 2
const  LIMIT_H = 3

fluent LANDING[drone:Drones] = <[drone].land,[drone].takeoff> initially 1
fluent LOW_BATTERY[drone:Drones] = <[drone].battery['low],[drone].battery['safe]> initially 0

fluent HIGH_ALT_1 = <drone[1].arrive[X][Y][3..S], {drone[1].arrive[X][Y][1..2], drone[1].land}> initially 0
fluent HIGH_ALT_2 = <drone[2].arrive[X][Y][3..S], {drone[2].arrive[X][Y][1..2], drone[2].land}> initially 0
fluent FLYING_1 = <drone[1].takeoff, drone[1].land> initially 0

ltl_property P_MOVE_LIMIT_1         = [](!['drone.[1]].arrive[LIMIT_X][Y][H])//ドローン1はLIMIT_Xに行けない
ltl_property P_LOW_BATTERY_LAND_1   = [](!LANDING['drone.[1]] -> !['drone.[1]].battery['safe])//安全状態には着陸中以外できない
ltl_property P_LOW_BATTERY_UP_1     = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].up)//低電池状態ではup、東、北移動できない
ltl_property P_LOW_BATTERY_MOVE_X_1 = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].move['e])
ltl_property P_LOW_BATTERY_MOVE_Y_1 = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].move['n])

ltl_property P_MOVE_LIMIT_2         = [](!['drone.[2]].arrive[X][LIMIT_Y][H])//ドローン2はLIMIT_Yに行けない
ltl_property P_LOW_BATTERY_LAND_2   = [](!LANDING['drone.[2]] -> !['drone.[2]].battery['safe])
ltl_property P_LOW_BATTERY_UP_2     = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].up)
ltl_property P_LOW_BATTERY_MOVE_X_2 = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].move['e])
ltl_property P_LOW_BATTERY_MOVE_Y_2 = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].move['n])

ltl_property P_NO_COLLISON_11 = [](['drone.[1]].arrive[X][Y][1] -> X(![Drones].arrive[X][Y][1] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))
ltl_property P_NO_COLLISON_12 = [](['drone.[1]].arrive[X][Y][2] -> X(![Drones].arrive[X][Y][2] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))
ltl_property P_NO_COLLISON_13 = [](['drone.[1]].arrive[X][Y][3] -> X(![Drones].arrive[X][Y][3] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))
ltl_property P_NO_COLLISON_14 = [](['drone.[1]].arrive[X][Y][4] -> X(![Drones].arrive[X][Y][4] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))
ltl_property P_NO_COLLISON_15 = [](['drone.[1]].arrive[X][Y][5] -> X(![Drones].arrive[X][Y][5] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))
ltl_property P_NO_COLLISON_16 = [](['drone.[1]].arrive[X][Y][6] -> X(![Drones].arrive[X][Y][6] W {['drone.[1]].arrive[X][Y][H], ['drone.[1]].land}))

ltl_property P_NO_COLLISON_21 = [](['drone.[2]].arrive[X][Y][1] -> X(![Drones].arrive[X][Y][1] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))
ltl_property P_NO_COLLISON_22 = [](['drone.[2]].arrive[X][Y][2] -> X(![Drones].arrive[X][Y][2] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))
ltl_property P_NO_COLLISON_23 = [](['drone.[2]].arrive[X][Y][3] -> X(![Drones].arrive[X][Y][3] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))
ltl_property P_NO_COLLISON_24 = [](['drone.[2]].arrive[X][Y][4] -> X(![Drones].arrive[X][Y][4] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))
ltl_property P_NO_COLLISON_25 = [](['drone.[2]].arrive[X][Y][5] -> X(![Drones].arrive[X][Y][5] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))
ltl_property P_NO_COLLISON_26 = [](['drone.[2]].arrive[X][Y][6] -> X(![Drones].arrive[X][Y][6] W {['drone.[2]].arrive[X][Y][H], ['drone.[2]].land}))

ltl_property P_NO_SAFE_AFTER_LOW_1 = [](drone[1].battery['low] -> X(!drone[1].battery['safe]))//どの時刻においても、ドローン1のバッテリーが  low  状態であれば、その直後（次の時刻）のステップでは  safe  状態に遷移してはならない


ltl_property P_LOW_BATTERY_NO_LAND_1     = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].land)
ltl_property P_LOW_BATTERY_NO_LAND_2     = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].land)
ltl_property P_LOW_DOWN_LIMIT_1 = []((LOW_BATTERY['drone.[1]] && !HIGH_ALT_1) -> !['drone.[1]].down)
ltl_property P_LOW_DOWN_LIMIT_2 = []((LOW_BATTERY['drone.[2]] && !HIGH_ALT_2) -> !['drone.[2]].down)
ltl_property P_LOW_BATTERY_MOVE_W_1 = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].move['w])
ltl_property P_LOW_BATTERY_MOVE_S_1 = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].move['s])
ltl_property P_LOW_BATTERY_MOVE_W_2 = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].move['w])
ltl_property P_LOW_BATTERY_MOVE_S_2 = [](LOW_BATTERY['drone.[2]] -> !['drone.[2]].move['s])
ltl_property P_NO_RECOVERY_1 = [](drone[1].battery['low] -> [](!drone[1].battery['safe]))
ltl_property P_NO_RECOVERY_2 = [](drone[2].battery['low] -> [](!drone[2].battery['safe]))

// 単体では「移動」を制限するだけ（回復できれば詰まない）
ltl_property P_REQUIREMENT_C = [](LOW_BATTERY['drone.[1]] -> !['drone.[1]].move['e])
ltl_property P_LIMIT_ALTITUDE = [](drone[1].arrive[X][Y][2] -> (!['drone.[1]].move['w] && !['drone.[1]].move['s]))
ltl_property P_RECOVER_ONLY_AT_LAND = [](LANDING['drone.[1]] -> !['drone.[1]].battery['low] )

//*****************************************************************************
// Controller
//*****************************************************************************

/* 従来の離散制御器合成 */
controllerSpec Specification =
{
	safety       = {
					P_MOVE_LIMIT_1,
					P_LOW_BATTERY_LAND_1,
					P_LOW_BATTERY_UP_1,
					P_LOW_BATTERY_MOVE_X_1,
					P_LOW_BATTERY_MOVE_Y_1,
					P_NO_COLLISON_11,
					P_NO_COLLISON_12,
					P_NO_COLLISON_13,
					P_NO_COLLISON_14,
					P_NO_COLLISON_15,
					P_NO_COLLISON_16,

					P_MOVE_LIMIT_2,
					P_LOW_BATTERY_LAND_2,
					P_LOW_BATTERY_UP_2,
					P_LOW_BATTERY_MOVE_X_2,
					P_LOW_BATTERY_MOVE_Y_2,
					P_NO_COLLISON_21,
					P_NO_COLLISON_22,
					P_NO_COLLISON_23,
					P_NO_COLLISON_24,
					P_NO_COLLISON_25,
					P_NO_COLLISON_26,

					P_NO_SAFE_AFTER_LOW_1,
				   }

	//liveness     = {GOAL}
	controllable = {ControllerbleActions}
}

controllerSpec Spec_Drone1_Only =
{
	safety       = {P_MOVE_LIMIT_1,
					//P_LOW_BATTERY_LAND_1,
					P_LOW_BATTERY_UP_1,
					P_LOW_BATTERY_MOVE_X_1,
					P_LOW_BATTERY_MOVE_Y_1,
					
					P_LOW_BATTERY_NO_LAND_1,
					P_NO_RECOVERY_1,
				   }
	//liveness     = {GOAL}
	controllable = {ControllerbleActions}
}


controllerSpec Spec_Drone2_Only =
{
	safety       = {P_MOVE_LIMIT_2,
					P_LOW_BATTERY_LAND_2,
					P_LOW_BATTERY_UP_2,
					P_LOW_BATTERY_MOVE_X_2,
					P_LOW_BATTERY_MOVE_Y_2,

					P_LOW_BATTERY_NO_LAND_2,
					P_NO_RECOVERY_2,
				   }
	//liveness     = {GOAL}
	controllable = {ControllerbleActions}
}

controllerSpec Spec_Collision_Avoidance =
{
	safety       = {P_NO_COLLISON_11,
					P_NO_COLLISON_12,
					P_NO_COLLISON_13,

					P_NO_COLLISON_21,
					P_NO_COLLISON_22,
					P_NO_COLLISON_23,
				   }
	//liveness     = {GOAL}
	controllable = {ControllerbleActions}
}


controllerSpec Specification3 =
{
	safety       = {
					P_MOVE_LIMIT_1,
					P_LOW_BATTERY_LAND_1,
					P_LOW_BATTERY_UP_1,
					P_LOW_BATTERY_MOVE_X_1,
					P_LOW_BATTERY_MOVE_Y_1,
					P_NO_COLLISON_11,
					P_NO_COLLISON_12,
					P_NO_COLLISON_13,
					P_NO_COLLISON_14,
					P_NO_COLLISON_15,
					P_NO_COLLISON_16,

					P_MOVE_LIMIT_2,
					P_LOW_BATTERY_LAND_2,
					P_LOW_BATTERY_UP_2,
					P_LOW_BATTERY_MOVE_X_2,
					P_LOW_BATTERY_MOVE_Y_2,
					P_NO_COLLISON_21,
					P_NO_COLLISON_22,
					P_NO_COLLISON_23,
					P_NO_COLLISON_24,
					P_NO_COLLISON_25,
					P_NO_COLLISON_26,
				   }
	//liveness     = {GOAL}
	controllable = {ControllerbleActions}
}
controller ||TraditionalController = (DroneEnvironment)~{Specification}.
controller ||Controller = ([Drones]:BATTERY || [Drones]:MOVE)~{Specification}.

//ドローン1だけの環境とコントローラ
||PartEnv1 = (drone[1]:BATTERY || drone[1]:MOVE).
controller ||C1 = (PartEnv1)~{Spec_Drone1_Only}.

// ドローン2だけの環境とコントローラ
||PartEnv2 = (drone[2]:BATTERY || drone[2]:MOVE).
controller ||C2 = (PartEnv2)~{Spec_Drone2_Only}.

//2台を合流させて衝突回避をかける
||FinalEnv = (C1 || C2).
controller ||StepwiseDroneController = (FinalEnv)~{Spec_Collision_Avoidance}.

controller ||Controller3 = (DroneEnvironment)~{Specification3}.
