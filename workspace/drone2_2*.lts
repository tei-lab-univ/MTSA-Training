//*****************************************************************************
// Environment
//*****************************************************************************

/* set variable (有限長) */
range COL = 0..4
range ROW = 0..4

/* set Actions (事象の集合) */
set RobotActions = {north, south, east, west}
set CourceActions = {arrive[COL][ROW]}
//set Mokemoke = {{ControllableActions}\{north}} //差集合なども表現可能



/* State machine figure */

// Robot Model
ROBOT_S = ROBOT,
ROBOT = (north -> ROBOT | south -> ROBOT | east -> ROBOT | west -> ROBOT).
//ROBOT = ({north, south, east, west} -> ROBOT). //上の同じ
//ROBOT = ({RobotActions} -> ROBOT). //上の同じ

// Cource Model
COURCE_S = COURCE[0][0],//Robotで変更
COURCE[a:COL][b:ROW] = (when(a < 4) south    -> arrive[a+1][b] -> COURCE[a+1][b]
             		   |when(a > 0) north    -> arrive[a-1][b] -> COURCE[a-1][b]
             		   |when(b < 4) east     -> arrive[a][b+1] -> COURCE[a][b+1]
             		   |when(b > 0) west     -> arrive[a][b-1] -> COURCE[a][b-1]).

|| RobotEnvironment = (ROBOT_S).
|| CourceEnvironment = (COURCE_S).

//*****************************************************************************
// Requirement
//*****************************************************************************
 
ltl_property DO_NOT_ENTER_X = [](!arrive[1][0] && !arrive[1][1] && !arrive[1][2] && !arrive[1][3] && !arrive[3][1] && !arrive[3][2] && !arrive[3][3] && !arrive[3][4])

//*****************************************************************************
// Controller
//*****************************************************************************
fluent GOAL = <arrive[4][4],RobotActions>

controllerSpec X =
{
	safety = {DO_NOT_ENTER_X}//安全性
	liveness     = {GOAL}//活性　ゴールに到達するという条件を満たすような遷移図を描かせる
	controllable = {RobotActions}//ロボットの動きは制御できる
}
controller ||C = (CourceEnvironment)~{X}.

//*****************************************************************************
// Image
//*****************************************************************************
// ┏━━━┳━━━┳━━━┓
// ┃ S ┃ x ┃ x ┃
// ┣━━━╋━━━╋━━━┫
// ┃   ┃ x ┃ x ┃
// ┣━━━╋━━━╋━━━┫
// ┃   ┃   ┃ G ┃
// ┗━━━┻━━━┻━━━┛
// S=スタート地点 G=ゴール地点 x=通れない場所


